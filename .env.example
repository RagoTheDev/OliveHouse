# ---- Olive House site configuration ----------------------------------------
# Copy this file to .env and fill in the values. All variables are optional;
# the site degrades gracefully when one is missing.

# Public URL where the site is deployed (used for canonical, Open Graph, sitemap).
VITE_SITE_URL=https://olivehouse.example.com

# WhatsApp number for direct booking inquiries, in international format with
# country code and NO plus sign, spaces or dashes (e.g. 255712345678).
# When empty, the WhatsApp inquiry button is hidden and guests are directed to Airbnb.
VITE_WHATSAPP_NUMBER=

# Optional contact e-mail shown in the footer and used as a fallback inquiry channel.
VITE_CONTACT_EMAIL=

# Official Airbnb listing URL (defaults to the Olive House listing).
VITE_AIRBNB_URL=https://www.airbnb.com/rooms/1759153791039194505

# Optional precise map pin. Leave blank to show the general Kigamboni area.
VITE_MAP_LAT=
VITE_MAP_LNG=

# Optional Google Maps place link for the house (used by "Open in Google Maps").
# When blank, a search link is built from the pin or the Kigamboni area.
VITE_GOOGLE_MAPS_URL=
